<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policymap [
<!ELEMENT policymap (policy)*>
<!ATTLIST policymap xmlns CDATA #FIXED "">
<!ELEMENT policy EMPTY>
<!ATTLIST policy xmlns CDATA #FIXED "" domain NMTOKEN #REQUIRED
  name NMTOKEN #IMPLIED pattern CDATA #IMPLIED rights NMTOKEN #IMPLIED
  stealth NMTOKEN #IMPLIED value CDATA #IMPLIED>
]>
<!--
  ImageMagick security policy for tmbo, replacing Debian's default.

  ImageMagick will decode anything it recognises, including formats that run
  code or read other files (SVG, MVG, MSL, PS/PDF via Ghostscript, text:@file).
  Uploads are sniffed by offensive/assets/upload.inc before Imagick sees them,
  but MP3 cover art is handed to Imagick unchecked, and every decoder that can
  run is attack surface. So: deny every coder, then allow only the formats the
  site accepts. JPG and JPE are aliases ImageMagick picks from a file's
  extension. HEIC and AVIF are deliberately left out: libheif's HEVC and AV1
  decoders stay out of reach.
-->
<policymap>
  <policy domain="resource" name="memory" value="256MiB"/>
  <policy domain="resource" name="map" value="512MiB"/>
  <policy domain="resource" name="width" value="16KP"/>
  <policy domain="resource" name="height" value="16KP"/>
  <policy domain="resource" name="area" value="128MP"/>
  <policy domain="resource" name="disk" value="1GiB"/>
  <policy domain="resource" name="time" value="60"/>

  <!-- no external programs (Ghostscript, ffmpeg, curl...), filters, or
       "@file" indirection -->
  <policy domain="delegate" rights="none" pattern="*"/>
  <policy domain="filter" rights="none" pattern="*"/>
  <policy domain="path" rights="none" pattern="@*"/>

  <policy domain="coder" rights="none" pattern="*"/>
  <policy domain="coder" rights="read|write" pattern="{GIF,JPEG,JPG,JPE,PNG,WEBP}"/>
</policymap>
